#!/bin/sh
set -e

# Core tools
brew install ghostty tmux neovim

# Supporting TUIs
brew install lazygit

# Dependencies
brew install stow fzf fd ripgrep direnv zoxide sesh starship zsh-vi-mode zsh-autosuggestions zsh-syntax-highlighting

# Language servers
brew install \
	bash-language-server \
	lua-language-server \
	marksman \
	pyright \
	ruff \
	typescript \
	vscode-langservers-extracted
