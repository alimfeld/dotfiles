#!/bin/sh
set -e

# Core tools
brew install ghostty tmux neovim

# Supporting TUIs
brew install lazygit hunk

# Dependencies
brew install stow fzf fd ripgrep zoxide sesh starship zsh-vi-mode zsh-autosuggestions zsh-syntax-highlighting raine/workmux/workmux

# Language servers
brew install \
	bash-language-server \
	lua-language-server \
	pyright \
	ruff \
	typescript-language-server \
	vscode-langservers-extracted
