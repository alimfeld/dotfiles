#!/usr/bin/env bash
# Switch to a tmux session, or kill one (or more) without leaving the picker.
# Each line also shows the agents workmux is tracking in that session's
# windows (a repo session can hold several worktrees/agents at once), one
# emoji per agent using workmux's own status_icons defaults
# (working, waiting, done), e.g. "myrepo  <emoji><emoji><emoji>".
# The current session is shown but can't be switched to or killed - it's
# marked "(current)" and filtered out of both actions.
#   enter   switch to the highlighted session
#   tab     multi-select
#   ctrl-k  kill the selected session(s), list stays open
#   esc     do nothing

set -euo pipefail

current=$(tmux display-message -p '#{session_name}')

if [[ ${1:-} == --list ]]; then
	agent_summary=$(workmux status --all --json 2>/dev/null | jq -r '
		def icon: {working: "\ud83e\udd16", waiting: "\ud83d\udcac", done: "\u2705"}[.] // "\u2753";
		.agents | group_by(.session)[]
		| "\(.[0].session)\t" + (map(.status | icon) | join(""))
	' 2>/dev/null) || true

	tmux list-sessions -F '#{session_name}' | while read -r s; do
		agents=$(awk -F'\t' -v s="$s" '$1==s{print $2}' <<<"$agent_summary")
		mark=""
		if [[ $s == "$current" ]]; then mark='(current)'; fi
		printf '%s\t%-24s\t%s\t%s\n' "$s" "$s" "${agents:-}" "$mark"
	done
	exit 0
fi

self=$(realpath "$0")

# fields: 1 raw name (hidden, used for actions), 2 padded name, 3 agents, 4 marker
selected=$("$self" --list | fzf -m --delimiter '\t' --with-nth 2,3,4 \
	--header 'enter: switch | tab: multi-select | ctrl-k: kill selected' \
	--bind "ctrl-k:execute-silent(echo {+1} | tr ' ' '\n' | grep -vFx '$current' | xargs -r -n1 tmux kill-session -t)+reload($self --list)") || true

target=$(head -n1 <<<"$selected" | awk -F'\t' '{print $1}')
[[ -z $target || $target == "$current" ]] && exit 0

tmux switch-client -t "$target"
