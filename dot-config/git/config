[user]
    name = Alexander Imfeld
    useConfigOnly = true

# Machine/work-specific identities (absent = ignored). Last rule wins, so the
# personal rules below stay after this include.
[include]
    path = ~/.config/local/git.inc

[includeIf "hasconfig:remote.*.url:https://github.com/alimfeld/*"]
    path = github.inc
[includeIf "hasconfig:remote.*.url:git@github.com:alimfeld/*"]
    path = github.inc
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/alimfeld/*"]
    path = github.inc

[core]
    autocrlf = input

[init]
    defaultBranch = main

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[help]
    autocorrect = prompt

[commit]
    verbose = true

[fetch]
    prune = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    followTags = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[rerere]
    enabled = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    tool = nvim_difftool

[difftool]
    prompt = false

[difftool "nvim_difftool"]
    cmd = nvim -c \"packadd nvim.difftool\" -d \"$LOCAL\" \"$REMOTE\"
